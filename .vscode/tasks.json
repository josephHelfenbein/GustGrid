{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake Configure",
            "command": "cmake",
            "args": [
                "-B",
                "build/debug",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake Build",
            "command": "cmake",
            "args": [
                "--build",
                "build/debug",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure",
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "CMake Configure Release",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake Build Release",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "dependsOn": "CMake Configure Release",
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "CMake Clean",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Configure + Build",
            "command": "cmake",
            "dependsOn": [
                "CMake Configure",
                "CMake Build"
            ],
            "dependsOrder": "sequence",
            "group": {"group": "build", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "CMake Configure + Build Release",
            "command": "cmake",
            "dependsOn": [
                "CMake Configure Release",
                "CMake Build Release"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Configure Release (Windows)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Ninja",
                "-S", ".",
                "-B", "build", 
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "-DVCPKG_TARGET_TRIPLET=x64-windows",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "group": "build"
        },
        {
            "label": "CMake Configure + Build Release (Windows)",
            "command": "cmake",
            "dependsOn": [
                "CMake Configure Release (Windows)",
                "CMake Build Release"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Configure Debug (Windows)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Ninja",
                "-S", ".",
                "-B", "build", 
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "-DVCPKG_TARGET_TRIPLET=x64-windows",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "group": "build"
        },
        {
            "label": "CMake Configure + Build Debug (Windows)",
            "command": "cmake",
            "dependsOn": [
                "CMake Configure Debug (Windows)",
                "CMake Build"
            ],
            "dependsOrder": "sequence",
            "group": {"group": "build", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure (VS2022 x64)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Visual Studio 17 2022",
                "-A", "x64",
                "-T", "host=x64",
                "-S", ".",
                "-B", "build",
                "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "-DVCPKG_TARGET_TRIPLET=x64-windows"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\Program Files\\CMake\\bin;${env:PATH}"
                }
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (VS2022 Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "--config", "Debug", "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\Program Files\\CMake\\bin;${env:PATH}"
                }
            },
            "group": { "kind": "build" },
            "dependsOn": "CMake: Configure (VS2022 x64)",
            "problemMatcher": [ "$msCompile" ]
        },
        {
            "label": "CMake: Build (VS2022 Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "--config", "Release", "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\Program Files\\CMake\\bin;${env:PATH}"
                }
            },
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "CMake: Configure (VS2022 x64)",
            "problemMatcher": [ "$msCompile" ]
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "Remove-Item -Recurse -Force build -ErrorAction SilentlyContinue"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
